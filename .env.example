# Copy to .env for local runs:  cp .env.example .env
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Phase 1 wires these to the docker-compose services.
MONGO_URI=mongodb://localhost:27017/arcade_arena
REDIS_URL=redis://localhost:6379

# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-64-plus-character-random-hex-string-not-this-one
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=2592000
